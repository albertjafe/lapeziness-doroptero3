+def _franja_margenes(fr: dict, ini: datetime, fin: datetime):
+    """Optional margins never replace the mandatory class interval."""
+    a = datetime.combine(ini.date(), datetime.strptime(fr.get("margen_ini", fr["ini"]), "%H:%M").time(), tzinfo=ini.tzinfo)
+    b = datetime.combine(fin.date(), datetime.strptime(fr.get("margen_fin", fr["fin"]), "%H:%M").time(), tzinfo=fin.tzinfo)
+    if not (a <= ini < fin <= b) or a.minute % 15 or b.minute % 15:
+        raise ValueError("Los márgenes deben rodear la clase y usar cuartos de hora")
+    return a, b
+
+
+def _franja_clase_entera(fr, d, ini, fin, ses, now, mias, tocan, occ):
+    """Try a whole class first, using the existing transaction/rollback path."""
+    from class_reservation_plan import full_class_plans
+    margen_ini, margen_fin = _franja_margenes(fr, ini, fin)
+    rooms = [a for a in _franja_salas_ordenadas()
+             if time.time() - _FRANJA_FALLOS.get((d, a), 0) > FRANJA_REINTENTO_S]
+    def allowed(aula, a, b, liberadas):
+        ids = {m["event_id"] for m in liberadas}
+        return (_franja_sala_libre(aula, a, b, occ, ids, now)
+                and not _franja_choque_1h(aula, a, b, mias, ids)
+                and not intersects_blind(a, b, d, ini.tzinfo, _blinds_efectivos(d)))
+    plans = full_class_plans(ini, fin, margen_ini, margen_fin, mias, rooms, now,
+                            allowed, MAX_RESERVA_HORAS * 60, obtener_grupo_aula)
+    if not plans:
+        return None
+    # One quota read for all candidates. Unknown quota must not release bookings.
+    try:
+        quota = fetch_cuotas_v2(ses["cookies"], ses["ua"], d)
+    except Exception:
+        quota = None
+    if not isinstance(quota, dict) or quota.get("rf_secs") is None:
+        return "pendiente: no pude comprobar la cuota para la clase"
+    def deficit(p):
+        liberadas = p["liberadas"]
+        rf = (p["fin"] - p["ini"]).total_seconds() / 60 - sum((m["fin"] - m["ini"]).total_seconds() / 60 for m in liberadas)
+        sz = _qlab_sz_minutes(p["ini"], p["fin"]) - sum(_qlab_sz_minutes(m["ini"], m["fin"]) for m in liberadas)
+        return (max(0, int(rf - quota["rf_secs"] // 60)),
+                max(0, int(sz - quota["sz_secs"] // 60)) if quota.get("sz_secs") is not None else 0)
+    plan = next((p for p in plans if not any(deficit(p))), None)
+    if plan is None:
+        # Reclaim quota only for the essential hour, never merely for margins.
+        core = min(plans, key=lambda p: (sum(deficit(p)), (p["fin"] - p["ini"]).total_seconds()))
+        return _franja_sin_cuota(d, fr["nombre"], f"{ini:%H:%M}–{fin:%H:%M}", deficit(core), ses, ini, now)
+    aula, a, b = plan["aula"], plan["ini"], plan["fin"]
+    if plan["unchanged"]:
+        return f"lista: aula {aula} {a:%H:%M}–{b:%H:%M} (clase entera)"
+    liberadas = plan["liberadas"]
+    if obtener_modo_reserva(ACTIVE_USER) == "anon" and liberadas:
+        return "aula para clase entera disponible; modo anónimo impide el cambio"
+    # Check again immediately before handing off, without releasing a lock.
+    if _manual_shutdown_requested():
+        return "pendiente: monitor cerrándose"
+    ok = False
+    try:
+        if plan["ampliar"] is not None:
+            ok, msg = _franja_ampliar(plan["ampliar"], a, b, ses, d)
+        elif not liberadas:
+            ok, msg = book_slot_hoy(ses["cookies"], ses["ua"], ACTIVE_USER, aula, a, b, mode=obtener_modo_reserva(ACTIVE_USER))
+        else:
+            cand = {"aula_objetivo": aula, "h_ini": a, "h_fin": b, "mig_ini": a, "mig_fin": b,
+                    "reservas_cubiertas": [(m["ini"], m["fin"], m["aula_str"], m["tipo"]) for m in liberadas],
+                    "clase_imprescindible": (ini, fin)}
+            send_tg(f"📌 {fr['nombre']}: priorizo la clase entera {ini:%H:%M}–{fin:%H:%M} "
+                    f"en aula {aula} ({a:%H:%M}–{b:%H:%M}); los extremos son opcionales.")
+            for m in liberadas:
+                _franja_candado(m["event_id"], False)
+            ok = ejecutar_migracion(cand, d)
+    finally:
+        # Includes new IDs assigned by a successful migration or its rollback.
+        try:
+            actuales = _franja_mias(ses["cookies"], ses["ua"], d, ini.tzinfo)
+        except Exception:
+            # Keep original IDs protected without claiming they still exist.
+            # Next successful class scan discovers and locks any replacement IDs.
+            for m in liberadas:
+                _reservation_set_locked(m["event_id"], True)
+            raise
+        for m in actuales:
+            if m["ini"] < fin and m["fin"] > ini:
+                _franja_candado(m["event_id"], True, d)
+    if not ok:
+        _FRANJA_FALLOS[(d, aula)] = time.time()
+        return f"cambio de clase a {aula} fallido; reviso las reservas restantes"
+    send_tg(f"📌 {fr['nombre']}: clase entera en aula {aula}, {a:%H:%M}–{b:%H:%M}. "
+            f"Horario imprescindible: {ini:%H:%M}–{fin:%H:%M}.")
+    return f"lista: aula {aula} {a:%H:%M}–{b:%H:%M} (clase entera)"
+
+
