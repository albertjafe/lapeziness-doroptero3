+def _max_reserva_set_minutes(minutes) -> str:
+    """Orden absoluta e idempotente de la app; confirma solo tras guardar."""
+    global MAX_RESERVA_HORAS
+    if (isinstance(minutes, bool) or not isinstance(minutes, int)
+            or not 30 <= minutes <= 1440 or minutes % 30):
+        raise ValueError("El máximo debe ser de 30 min a 24 h, en pasos de 30 min")
+    anterior = MAX_RESERVA_HORAS
+    MAX_RESERVA_HORAS = minutes / 60
+    if not _max_reserva_save():
+        MAX_RESERVA_HORAS = anterior
+        raise OSError("No pude guardar el máximo; se conserva el anterior")
